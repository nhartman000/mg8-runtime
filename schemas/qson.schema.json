{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QSON Execution Trace Ledger",
  "description": "Minimum interoperable schema for append-only MG8 execution trace events.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "qson_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/event"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["qson_version", "run_id", "events"],
  "definitions": {
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["type", "id"]
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "type": "string",
          "enum": [
            "gate_attempt",
            "override",
            "correction",
            "state_commit",
            "external_input",
            "runtime_error",
            "review"
          ]
        },
        "file_id": {
          "type": "string"
        },
        "gate_id": {
          "type": "string"
        },
        "input_state_id": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INTERMEDIATE"]
        },
        "action": {
          "type": ["string", "object", "null"]
        },
        "output_state_id": {
          "type": ["string", "null"]
        },
        "operation": {
          "type": ["string", "object", "null"]
        },
        "actor": {
          "$ref": "#/definitions/actor"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string"
        },
        "evidence": {},
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "previous_event_hash": {
          "type": "string"
        },
        "event_hash": {
          "type": "string"
        },
        "signature": {}
      },
      "required": ["trace_id", "run_id", "sequence", "event_type", "actor"]
    }
  }
}
